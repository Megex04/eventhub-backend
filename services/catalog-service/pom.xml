<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eventhub</groupId>
    <artifactId>eventhub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>catalog-service</artifactId>
  <name>catalog-service</name>
  <description>Event catalog: events, ticket zones and lifecycle (Spring MVC + JPA)</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- JPA/Hibernate, Spring Data and transaction management (@Transactional on use cases). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Schema is owned by Flyway migrations only (ddl-auto=validate). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The service is an OAuth2 Resource Server: it validates Keycloak/Entra JWTs, it never issues them. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Distributed tracing: puts traceId/spanId in the logging context (and so in the JSON logs). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Metrics in Prometheus format at /actuator/prometheus (protected, see SecurityConfig). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Broker abstraction (CLAUDE.md): the outbox relay sends through StreamBridge; RabbitMQ locally. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-stream-rabbit</artifactId>
    </dependency>
    <!-- The generated request models carry Jakarta Validation constraints taken from the OpenAPI schema. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @AutoConfigureMetrics / @AutoConfigureTracing: Boot tests switch both off unless asked. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Enforces the hexagonal dependency rules of CLAUDE.md in the build. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Shared test helpers: event JSON Schemas and OpenAPI validator, read from contracts/. -->
    <dependency>
      <groupId>com.eventhub</groupId>
      <artifactId>contract-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Checks real responses against contracts/openapi/catalog-api.yaml (status, headers, schema). -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-mockmvc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- One PostgreSQL container per test JVM, wired through @DynamicPropertySource. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Coverage (CLAUDE.md): the build fails if the domain drops under 90 % of lines; the application
        layer (target 80 %) is only reported. Generated code and the main class are not measured.
        prepare-agent covers unit tests (surefire) and integration tests (failsafe) in one report.
      -->
      <!--
        Two surefire executions, each with its own JaCoCo agent file: the tests of the domain package
        run alone (jacoco-domain.exec) and every other unit test runs apart (jacoco-ut.exec). The
        domain gate reads only the first one, so the domain has to be covered by ITS OWN tests; tests
        of other layers that happen to walk through domain code do not count towards it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <argLine>@{surefireArgLine}</argLine>
              <excludes>
                <exclude>**/domain/**</exclude>
                <exclude>**/*$*</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>domain-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <argLine>@{domainArgLine}</argLine>
              <!-- Without domain tests there is no jacoco-domain.exec and JaCoCo would skip the gate. -->
              <failIfNoTests>true</failIfNoTests>
              <includes>
                <include>**/domain/*Test.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{failsafeArgLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>com/eventhub/catalog/infrastructure/adapter/in/web/api/**</exclude>
            <exclude>com/eventhub/catalog/infrastructure/adapter/in/web/model/**</exclude>
            <exclude>com/eventhub/catalog/CatalogServiceApplication.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <!--
            Unit tests (surefire) and integration tests (failsafe) run in separate JVMs, so each gets
            its own file and append=false: a stale file from an earlier run cannot inflate the gate,
            and one JVM cannot overwrite the other's data. They are merged before report and checks.
          -->
          <execution>
            <id>agent-domain</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-domain.exec</destFile>
              <propertyName>domainArgLine</propertyName>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>agent-ut</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-ut.exec</destFile>
              <propertyName>surefireArgLine</propertyName>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>agent-it</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-it.exec</destFile>
              <propertyName>failsafeArgLine</propertyName>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>merge</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco-domain.exec</include>
                    <include>jacoco-ut.exec</include>
                    <include>jacoco-it.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>domain-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- Only what the domain's own tests executed. -->
              <dataFile>${project.build.directory}/jacoco-domain.exec</dataFile>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.eventhub.catalog.domain</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>application-report-only</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.eventhub.catalog.application.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Contract-first: the REST interfaces and DTOs are generated from the OpenAPI file that is the
        source of truth. Output goes to target/generated-sources and is never versioned.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>catalog-api</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../../contracts/openapi/catalog-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.eventhub.catalog.infrastructure.adapter.in.web.api</apiPackage>
              <modelPackage>com.eventhub.catalog.infrastructure.adapter.in.web.model</modelPackage>
              <!-- Suffix keeps DTOs distinct from the domain's Money, TicketZone and EventStatus. -->
              <modelNameSuffix>Dto</modelNameSuffix>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateSupportingFiles>false</generateSupportingFiles>
              <typeMappings>
                <typeMapping>DateTime=Instant</typeMapping>
              </typeMappings>
              <importMappings>
                <importMapping>Instant=java.time.Instant</importMapping>
              </importMappings>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <delegatePattern>false</delegatePattern>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <useBeanValidation>true</useBeanValidation>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <!-- Null handling is governed by spring.jackson.default-property-inclusion instead. -->
                <generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
                <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                <!-- No swagger-annotations / springdoc: the OpenAPI file itself is the documentation. -->
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
