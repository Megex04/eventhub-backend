# Copy to `.env` for local overrides. Development-only values: never reuse them outside local Docker.
# docker-compose.yml falls back to these same defaults when `.env` does not exist.
#
# Running catalog-service with `-Dspring-boot.run.profiles=local` reads POSTGRES_PORT, POSTGRES_DB,
# POSTGRES_USER and POSTGRES_PASSWORD from the environment. The password has no default in the
# application config on purpose: export it first, e.g.  export POSTGRES_PASSWORD=eventhub_dev

POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub_dev
POSTGRES_DB=catalog
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=eventhub
RABBITMQ_DEFAULT_PASS=eventhub_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
KEYCLOAK_PORT=8080
