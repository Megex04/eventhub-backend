# Copy to `.env` for local overrides. Development-only values: never reuse them outside local Docker.
# docker-compose.yml falls back to these same defaults when `.env` does not exist.
#
# Running catalog-service with `-Dspring-boot.run.profiles=local` reads POSTGRES_PORT, POSTGRES_DB,
# POSTGRES_USER and POSTGRES_PASSWORD from the environment. The password has no default in the
# application config on purpose: export it first, e.g.  export POSTGRES_PASSWORD=eventhub_dev

POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub_dev
POSTGRES_DB=catalog
POSTGRES_PORT=5432

# The `local` profile reads RABBITMQ_DEFAULT_USER (default eventhub) and RABBITMQ_DEFAULT_PASS (no
# default, like POSTGRES_PASSWORD): export it before running, e.g.  export RABBITMQ_DEFAULT_PASS=eventhub_dev
RABBITMQ_DEFAULT_USER=eventhub
RABBITMQ_DEFAULT_PASS=eventhub_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
KEYCLOAK_PORT=8080

# catalog-service validates JWTs against this issuer. The `local` profile already defaults to the
# Keycloak realm from docker-compose, so set it only to point at another issuer (e.g. Entra ID).
# OIDC_ISSUER_URI=http://localhost:8080/realms/eventhub

# booking-service: the `local` profile uses the `booking` database (BOOKING_DB overrides it) created by
# docker/postgres/init-booking.sql. On a data volume that already exists, create it by hand:
#   docker compose exec postgres psql -U eventhub -d catalog -c "CREATE DATABASE booking;"
