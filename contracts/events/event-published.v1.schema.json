{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhub.dev/schemas/events/event-published.v1.schema.json",
  "title": "EventPublished v1",
  "description": "Un evento paso a PUBLISHED. booking-service crea el inventario por zona. Routing key: `catalog.event.published.v1`.",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "EventPublished"
        },
        "version": {
          "const": 1
        },
        "producer": {
          "const": "catalog-service"
        },
        "data": {
          "type": "object",
          "required": [
            "eventId",
            "organizerId",
            "title",
            "venue",
            "startsAt",
            "endsAt",
            "zones"
          ],
          "additionalProperties": false,
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "organizerId": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "venue": {
              "type": "string"
            },
            "startsAt": {
              "type": "string",
              "format": "date-time"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time"
            },
            "zones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "zoneId",
                  "name",
                  "capacity",
                  "price"
                ],
                "additionalProperties": false,
                "properties": {
                  "zoneId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "price": {
                    "$ref": "common.v1.schema.json#/$defs/Money"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
