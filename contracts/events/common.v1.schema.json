{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhub.dev/schemas/events/common.v1.schema.json",
  "title": "Common definitions v1",
  "$defs": {
    "Money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d{1,10}\\.\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
